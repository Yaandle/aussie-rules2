; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Aussie Rules 2"
config/description="Realistic-leaning 3D Aussie Rules football. Physical resolution, controller-first."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputManager="*res://scripts/autoload/input_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
ControlMode="*res://scripts/autoload/control_mode.gd"
MatchState="*res://scripts/autoload/match_state.gd"
CharacterProfile="*res://scripts/autoload/character_profile.gd"
CareerProfile="*res://scripts/autoload/career_profile.gd"
SceneWipe="*res://scripts/autoload/scene_wipe.gd"
Settings="*res://scripts/autoload/settings.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

