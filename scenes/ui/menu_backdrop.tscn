[ext_resource type="Script" path="res://scripts/ui/menu_backdrop.gd" id="1_backdrop"]
[ext_resource type="Environment" path="res://materials/menu_environment.tres" id="2_env"]

[node name="MenuBackdrop" type="Node3D"]
script = ExtResource("1_backdrop")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = ExtResource("2_env")

; Late-afternoon sun, low (about 20 degrees up) and warm, matching the
; menu reference image: long shadows across the turf, golden light on the
; posts and players. Written as rotation_degrees rather than a Transform3D
; literal on purpose: the 12 numbers in a Transform3D are the basis ROWS,
; and writing an axis along them instead of down them gave this scene a sun
; that pointed at the sky (see character_backdrop.tscn's note). A light
; shines down its -Z, so x = -20 is 20 degrees below the horizon line.
[node name="Sun" type="DirectionalLight3D" parent="."]
rotation_degrees = Vector3(-20, 155, 0)
light_color = Color(1, 0.84, 0.66, 1)
light_energy = 1.15
shadow_enabled = true
directional_shadow_max_distance = 120.0

; Cool sky bounce from the opposite side, keeping the shaded faces of the
; posts and players in the palette rather than letting them fall to grey.
[node name="FillLight" type="DirectionalLight3D" parent="."]
rotation_degrees = Vector3(-40, -140, 0)
light_energy = 0.28
light_color = Color(0.82, 0.9, 1, 1)
shadow_enabled = false

[node name="Camera3D" type="Camera3D" parent="."]
fov = 62.0
