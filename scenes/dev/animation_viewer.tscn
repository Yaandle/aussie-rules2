[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/dev/animation_viewer.gd" id="1_viewer"]
[ext_resource type="Environment" path="res://materials/dev_studio_environment.tres" id="2_env"]

; Dev-only scene: a bare HumanoidRig in an empty white studio box, driven by
; a real AnimationTree, with a button-driven UI to preview every locomotion
; blend point and discrete action clip in isolation. Deliberately NOT the
; real field.tscn/character_backdrop.tscn look this started from — that
; read as "another game mode" rather than an isolated animation preview, so
; there's no turf/oval/goalposts here at all, just a flat wireframe floor
; grid (built in code, see _build_studio_floor) under plain white sky.
;
; Not reachable from the main menu — open this directly in the editor and
; press F6, same precedent as scenes/main.tscn. Everything except the
; environment/light/camera shell is built in code by animation_viewer.gd
; (the rig, the floor grid, the AnimationPlayer/AnimationTree/
; PlayerAnimation trio, and the whole UI), same reasoning as
; character_screen.tscn leaving its UI node empty.

[node name="AnimationViewer" type="Node3D"]
script = ExtResource("1_viewer")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = ExtResource("2_env")

; Soft key light from above and to camera-left. A gentle contact shadow is
; enabled now that the viewer renders a higher-detail figure (a fill light
; and studio floor are added in code — see animation_viewer.gd _ready) — it
; grounds the model without turning the flat-white studio into a harsh
; single-source scene. shadow_blur softens the edge to match the soft key.
[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.8993, 0.2622, -0.3499, 0, 0.8002, 0.5998, 0.4372, -0.5394, 0.7197, 0, 40, 0)
light_energy = 0.85
shadow_enabled = true
shadow_blur = 2.0
directional_shadow_max_distance = 20.0

[node name="Camera3D" type="Camera3D" parent="."]
fov = 55.0

[node name="Overlay" type="CanvasLayer" parent="."]

[node name="UI" type="Control" parent="Overlay"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
