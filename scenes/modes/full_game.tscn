[ext_resource type="PackedScene" path="res://scenes/field/field.tscn" id="2_field"]
[ext_resource type="PackedScene" path="res://scenes/ball/ball.tscn" id="3_ball"]
[ext_resource type="PackedScene" path="res://scenes/camera/broadcast_camera.tscn" id="4_camera"]
