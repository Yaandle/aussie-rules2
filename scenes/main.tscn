; Afternoon sun, travelling (-0.35, -0.72, -0.60) — downward at about 46
; degrees. Replaces the transposed literal docs/HANDOVER.md warns about,
; which aimed the sun upward and left every horizontal surface lit by sky
; ambient alone. See full_game.tscn for the full note.
[node name="Sun" type="DirectionalLight3D" parent="." unique_id=464142346]
transform = Transform3D(0.8637, -0.3627, 0.3499, 0, 0.6943, 0.7197, -0.5039, -0.6216, 0.5998, 0, 40, 0)
; Eased down from 1.7 now that the sun actually reaches the ground: at
; full strength over the sky ambient the pitch clipped to flat white on
; the lit side, which is the opposite of the calm overcast afternoon this
; is meant to be.
light_energy = 1.05
; Penumbra width in degrees. The real sun subtends about half a degree;
; overcast light is far wider, and this is what turns a hard-edged
; stencil of a player into the soft ground shadow the brief asks for.
; It is not a post effect — the directional soft-shadow filter is already
; on (project.godot sets soft_shadow_filter_quality=3) and was simply
; being handed a zero-radius source to filter.
light_angular_distance = 2.2
; Shadows sit at three-quarter strength rather than fully occluding, so
; the shaded side of the ground keeps its colour instead of going to a
; grey silhouette.
shadow_opacity = 0.72
shadow_enabled = true
directional_shadow_max_distance = 120.0
directional_shadow_blend_splits = true

