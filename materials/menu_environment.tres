[gd_resource type="Environment" load_steps=3 format=3]

[sub_resource type="ProceduralSkyMaterial" id="SkyMat_menu"]
sky_top_color = Color(0.404, 0.573, 0.769, 1)
sky_horizon_color = Color(0.816, 0.867, 0.906, 1)
sky_curve = 0.13
; Matched to turf.gdshader's `surround` park grass, hazing toward the sky
; at the horizon so the far edge of the ground plane has nothing to show
; against.
ground_bottom_color = Color(0.31, 0.396, 0.271, 1)
ground_horizon_color = Color(0.671, 0.729, 0.694, 1)
sun_angle_max = 26.0
sun_curve = 0.12

[sub_resource type="Sky" id="Sky_menu"]
sky_material = SubResource("SkyMat_menu")

[resource]
background_mode = 2
sky = SubResource("Sky_menu")
ambient_light_source = 3
; Was 2.1, which existed to rescue a scene whose sun pointed at the sky
; (see menu_backdrop.tscn). With the sun corrected, ambient anywhere near
; that flattens the montage into a white haze — sun plus fill plus ambient
; pushes the mid greens high enough up the ACES curve that the tonemapper
; desaturates them, and the whole ground comes out pastel.
ambient_light_energy = 0.45
reflected_light_source = 2
tonemap_mode = 3
tonemap_white = 5.0
; Fine glow mips only — see broadcast_environment.tres for why 5 and 7
; leave visible rectangular blocks in the image.
glow_enabled = true
glow_levels/2 = 1.0
glow_levels/3 = 1.0
glow_intensity = 0.22
glow_bloom = 0.02
glow_hdr_threshold = 1.3
glow_blend_mode = 2
ssao_enabled = false
fog_enabled = true
fog_light_color = Color(0.788, 0.843, 0.886, 1)
fog_density = 0.0007
fog_aerial_perspective = 0.1
fog_sky_affect = 0.0
