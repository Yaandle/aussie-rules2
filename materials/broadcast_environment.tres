[gd_resource type="Environment" load_steps=3 format=3]

; Match environment: bright overcast afternoon. Shared by full_game,
; kick_to_kick and main.
;
; Retuned once the scenes' Sun actually pointed at the ground (it was
; transposed, and aimed at the sky — see full_game.tscn's note). Every
; number here had been pushed up to compensate for a pitch lit by nothing
; but sky ambient: 1.15 of ambient with a strong bloom over it. With real
; sunlight arriving, the same settings render a blown-out, hazy field, so
; ambient comes down to a fill role and the glow stops carrying the image.

[sub_resource type="ProceduralSkyMaterial" id="SkyMat_broadcast"]
; Softer and paler than the near-primary blue this had. A saturated sky
; is the single largest block of colour on screen and it was pulling the
; whole frame's colour balance with it.
sky_top_color = Color(0.404, 0.573, 0.769, 1)
sky_horizon_color = Color(0.816, 0.867, 0.906, 1)
sky_curve = 0.13
; Matched to turf.gdshader's `surround` park grass, hazing toward the sky
; at the horizon so the far edge of the ground plane has nothing to show
; against.
ground_bottom_color = Color(0.31, 0.396, 0.271, 1)
ground_horizon_color = Color(0.671, 0.729, 0.694, 1)
sun_angle_max = 30.0
sun_curve = 0.15

[sub_resource type="Sky" id="Sky_broadcast"]
sky_material = SubResource("SkyMat_broadcast")

[resource]
background_mode = 2
sky = SubResource("Sky_broadcast")
ambient_light_source = 3
; Fill, not key. At 1.15 this was doing the sun's job as well as its own.
ambient_light_energy = 0.5
reflected_light_source = 2
tonemap_mode = 3
tonemap_white = 5.0
; Glow moved off the coarsest mips. Levels 5 and 7 are the 1/32 and 1/128
; buffers — at 720p the last one is a handful of pixels across, and
; blurring something that small quantises into blocks whose edges land on
; 128px screen boundaries and read as flat rectangles in the image. Levels
; 2 and 3 are fine enough to stay smooth, and are where a highlight bloom
; actually lives anyway.
glow_enabled = true
glow_levels/2 = 1.0
glow_levels/3 = 1.0
glow_intensity = 0.2
glow_bloom = 0.02
glow_hdr_threshold = 1.3
glow_blend_mode = 2
; SSAO off. The scene is a flat plane with a handful of capsule figures
; and four posts on it, so there is almost no occlusion to describe —
; and screen-space AO is at its worst on a large ground plane viewed at a
; grazing angle, where it produces exactly the banded blotches the brief
; calls out. Removing it is both cleaner and cheaper.
ssao_enabled = false
; Thin aerial perspective, so the far end of the ground sits back from the
; near end. Density is very low on purpose — this is depth, not weather.
fog_enabled = true
fog_light_color = Color(0.788, 0.843, 0.886, 1)
fog_sun_scatter = 0.05
fog_density = 0.0009
fog_aerial_perspective = 0.1
fog_sky_affect = 0.0
